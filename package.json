{
  "name": "fex-api",
  "version": "1.0.0",
  "description": "Fex Protocol - Payment Service Providers API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "artillery:run": "npx artillery run -o artillery-results.json -e local ./artillery.yml",
    "artillery:report": "npx artillery export -o artillery-report.html artillery-results.json"
  },
  "dependencies": {
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "axios": "1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "nestjs-pino": "4.6.1",
    "p-limit": "7.3.1",
    "pg": "^8.23.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simpleflakes": "^4.4.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.29",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "7.2.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
